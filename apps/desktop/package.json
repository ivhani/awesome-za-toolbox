{
  "name": "@awesome-za/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop application for Awesome ZA Toolbox.",
  "license": "MIT",
  "author": "Awesome ZA Toolbox contributors",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "smoke": "electron . --smoke-test",
    "visual-smoke": "node tests/electron-visual-smoke.mjs",
    "package:win": "pnpm build && electron-builder --win --dir --publish never",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('release', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@awesome-za/core": "workspace:*",
    "@awesome-za/ejoburg": "workspace:*",
    "@awesome-za/fnb": "workspace:*",
    "@awesome-za/schemas": "workspace:*",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "za.awesome.toolbox",
    "productName": "Awesome ZA Toolbox",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
