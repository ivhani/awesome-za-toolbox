{
  "name": "za-toolbox",
  "version": "0.1.0",
  "description": "CLI for local-first South African document conversion tools.",
  "license": "MIT",
  "keywords": [
    "south-africa",
    "pdf",
    "bank-statement",
    "municipal",
    "fnb",
    "ejoburg",
    "cli"
  ],
  "homepage": "https://github.com/ivhani/awesome-za-toolbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivhani/awesome-za-toolbox.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/ivhani/awesome-za-toolbox/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "za-toolbox": "dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": {
      "types": "dist/index.d.ts",
      "import": "dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external exceljs",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@awesome-za/ejoburg": "workspace:*",
    "@awesome-za/fnb": "workspace:*",
    "@awesome-za/workbooks": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "tsx": "^4.20.5"
  }
}
