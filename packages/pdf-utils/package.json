{
  "name": "@awesome-za/pdf-utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@awesome-za/core": "workspace:*",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
